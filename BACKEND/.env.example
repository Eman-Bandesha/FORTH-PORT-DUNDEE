# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Database — leave unset to use SQLite locally.
# Production (Render/Neon): paste the full connection string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DB_SSL_REQUIRE=true
#
# Or discrete Postgres vars:
# POSTGRES_DB=forthports
# POSTGRES_USER=forthports
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Email — fill BREVO_* to deliver real inbox emails (not console-only).
# Brevo → SMTP & API → copy login + SMTP key. Verify sender under Senders.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
BREVO_SMTP_USERNAME=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=Forth Ports Dundee <noreply@your-verified-domain.com>

# Password reset
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_IP_RATE_LIMIT=10
PASSWORD_RESET_USER_RATE_LIMIT=5
# Only for local debugging — never enable in production
EXPOSE_OTP_IN_DEBUG=false

# CORS / CSRF (production — set after you know your Render + Vercel URLs)
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-admin.vercel.app

